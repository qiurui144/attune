  "corpora": [
    "networking_tcpip_smoke",
    "airplane_manuals",
    "mechanical_design_handbook"
  ],
  "scenarios": [
    "networking_tcpip_troubleshooting",
    "airplane_operation_guidance",
    "mechanical_design_multiturn"
  ],
  "gates": [
    "scheduler_contract",
    "nas_web_api_contract",
    "web_demo_playwright",
    "ingest",
    "search",
    "chat",
    "summary",
    "multiturn"
  ],
  "thresholds": {
    "retrieval_hit_at_5_min": 0.85,
    "citation_hit_rate_min": 0.9,
    "answer_accuracy_min": 0.8,
    "terminal_error_rate_max": 0.02,
    "hot_chat_p95_ms_max": 30000,
    "longtext_chat_p95_ms_max": 60000
