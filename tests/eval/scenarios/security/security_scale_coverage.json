{
  "schema_version": "attune.eval.scenario.v1",
  "scenario_id": "security_scale_coverage",
  "domain": "security",
  "scenario_type": "high_complexity_longtext",
  "difficulty": "stress",
  "corpus_id": "security_generated_thousand_docs",
  "coverage": {
    "question_types": [
      "fact_lookup",
      "operation_guidance",
      "decision_assistance",
      "summary",
      "multiturn",
      "negative_evidence",
      "out_of_manual_industry_general"
    ],
    "minimum_turns_per_type": 1,
    "same_industry_only": true
  },
  "turns": [
    {
      "turn_id": "fact_lookup_access_control",
      "message": "在 security 知识库中，access control 主题的证据要点是什么？",
      "answer_mode": "fact_lookup",
      "requires_citations": true,
      "expected_sources": ["security::access-control"],
      "must_include": ["security", "access control", "证据", "引用"],
      "must_not_include": ["networking", "mechanical", "无引用结论"],
      "latency_budget_ms": 30000
    },
    {
      "turn_id": "operation_guidance_incident_response",
      "message": "如何基于 security 知识库证据排查 incident response 流程问题？",
      "answer_mode": "operation_guidance",
      "requires_citations": true,
      "expected_sources": ["security::incident-response", "generated:security-support-workflow"],
      "must_include": ["用户症状", "证据", "日志", "不要编造"],
      "must_not_include": ["跨行业", "无引用结论"],
      "latency_budget_ms": 30000
    },
    {
      "turn_id": "decision_assistance_risk_assessment",
      "message": "在 risk assessment 和 audit evidence 之间，应该先收集哪些证据再给建议？",
      "answer_mode": "decision_assistance",
      "requires_citations": true,
      "expected_sources": ["security::risk-assessment", "security::audit-evidence"],
      "must_include": ["risk assessment", "audit evidence", "先收集", "证据"],
      "must_not_include": ["直接批准", "无需证据"],
      "latency_budget_ms": 30000
    },
    {
      "turn_id": "summary_security_controls",
      "message": "请总结 security 知识库中访问控制、事件响应、风险评估和审计证据的核心要点。",
      "answer_mode": "summary",
      "requires_citations": true,
      "expected_sources": ["security::access-control", "security::incident-response", "security::risk-assessment", "security::audit-evidence"],
      "must_include": ["access control", "incident response", "risk assessment", "audit evidence"],
      "must_not_include": ["无来源总结", "跨行业"],
      "latency_budget_ms": 45000
    },
    {
      "turn_id": "multiturn_source_continuity",
      "message": "继续上一问，只基于刚才 security 引用来源说明还缺哪些材料。",
      "answer_mode": "multiturn",
      "requires_citations": true,
      "expected_sources": ["security::risk-assessment", "security::audit-evidence"],
      "must_include": ["继续", "security", "材料", "引用"],
      "must_not_include": ["换到 networking", "换到 mechanical"],
      "latency_budget_ms": 45000
    },
    {
      "turn_id": "negative_evidence_refusal",
      "message": "如果知识库没有某个资产的审计日志，能否直接判定它合规？",
      "answer_mode": "negative_evidence",
      "requires_citations": true,
      "expected_sources": ["security::audit-evidence"],
      "must_include": ["不能直接判定", "审计日志", "证据不足", "继续索取"],
      "must_not_include": ["直接合规", "无需审计"],
      "latency_budget_ms": 30000
    },
    {
      "turn_id": "out_of_manual_zero_trust_boundary",
      "message": "如果手册没有直接覆盖零信任网络分段，但客户问能不能作为安全整改建议，应该如何回答？",
      "answer_mode": "out_of_manual_industry_general",
      "requires_citations": true,
      "expected_sources": ["security::access-control", "security::risk-assessment", "security::asset-inventory"],
      "must_include": ["知识库未直接覆盖", "行业通用", "证据不足", "不能当作手册结论"],
      "must_not_include": ["手册已明确要求零信任", "无需引用"],
      "latency_budget_ms": 30000
    }
  ],
  "scheduler": {
    "expected_task": "kb.query.ask",
    "allow_async": true,
    "require_local_scheduler_metadata": true
  }
}
